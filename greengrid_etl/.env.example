# ETL Environment Configuration
# Copy this file to config/.env and fill in your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ncdc_greengrid
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Data Source Configuration
DATA_URL=https://services.arcgis.com/1dSrzEWVQn5kHHyK/arcgis/rest/services/Ambiente_DMEVAE/FeatureServer/0/query?outFields=*&where=1%3D1&f=geojson
OUTPUT_FILENAME=trees.geojson
DATA_DIRECTORY=./data

# Processing Configuration
LOG_LEVEL=INFO
LOG_FILE=etl_logs/etl_execution.log
